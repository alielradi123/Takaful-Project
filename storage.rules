rules_version = '2';

// ============================================================
//  قواعد أمان Storage — مشروع تكافل
//  مجلدات: profile_images | case_images | documents
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ── دوال مساعدة ──────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    // حجم الملف أقل من 5MB
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // نوع الملف صورة فقط
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // نوع الملف صورة أو PDF
    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // ── صور الملفات الشخصية ───────────────────────────────────
    match /profile_images/{userId}/{fileName} {
      // القراءة: الإدارة أو المستخدم نفسه
      allow read: if request.auth != null &&
        (request.auth.uid == userId);

      // الرفع: المستخدم نفسه فقط، صورة أقل من 5MB
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        isImage() &&
        isValidSize();

      // الحذف: المستخدم نفسه
      allow delete: if request.auth != null &&
        request.auth.uid == userId;
    }

    // ── صور الحالات الإنسانية ─────────────────────────────────
    match /case_images/{caseId}/{fileName} {
      // القراءة: أي مستخدم مسجّل
      allow read: if isLoggedIn();

      // الرفع: أي مستخدم مسجّل (المستفيدون يرفعون صور حالاتهم)
      allow write: if isLoggedIn() &&
        isImageOrPdf() &&
        isValidSize();

      // الحذف: المسجّل فقط (التحكم الدقيق يكون عبر Firestore rules)
      allow delete: if isLoggedIn();
    }

    // ── المستندات الداعمة ──────────────────────────────────────
    match /documents/{userId}/{fileName} {
      allow read: if isLoggedIn();
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        isImageOrPdf() &&
        isValidSize();
      allow delete: if request.auth != null &&
        request.auth.uid == userId;
    }

    // ── منع أي وصول لمجلدات غير محددة ────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
