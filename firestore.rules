rules_version = '2';

// ============================================================
//  قواعد أمان Firestore — مشروع تكافل
//  Collections: users | cases | donations | notifications
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ──────────────────────────────────────────

    // هل المستخدم مسجّل الدخول؟
    function isLoggedIn() {
      return request.auth != null;
    }

    // جلب بيانات المستخدم الحالي من Firestore
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // هل هو عضو إداري (admin / employee / supervisor / manager)؟
    function isAdmin() {
      return isLoggedIn() &&
        myData().status != 'suspended' &&
        myData().role in ['admin', 'employee', 'supervisor', 'manager'];
    }

    // هل هو Admin كامل الصلاحيات؟
    function isSuperAdmin() {
      return isLoggedIn() &&
        myData().status != 'suspended' &&
        myData().role == 'admin';
    }

    // هل يملك المستخدم هذا الوثيقة بنفسه؟
    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function isBeneficiary() {
      return isLoggedIn()
        && myData().get('status', '') != 'suspended'
        && (myData().get('role', '') == 'beneficiary'
          || myData().get('accountType', '') == 'beneficiary');
    }

    function isVolunteer() {
      return isLoggedIn()
        && myData().get('status', '') != 'suspended'
        && myData().get('role', '') == 'volunteer';
    }

    function isAssignedVolunteerCompletingCase() {
      return isVolunteer()
        && resource.data.get('status', '') in ['assigned', 'active']
        && (resource.data.get('volunteerId', '') == request.auth.uid
          || resource.data.get('assignedVolunteerId', '') == request.auth.uid)
        && request.resource.data.get('volunteerId', '') == resource.data.get('volunteerId', '')
        && request.resource.data.get('assignedVolunteerId', '') == resource.data.get('assignedVolunteerId', '')
        && request.resource.data.get('status', '') == 'completed'
        && request.resource.data.get('proofUrl', '') != ''
        && request.resource.data.get('volunteerReportImage', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completedAt', 'volunteerReport', 'volunteerNotes',
            'volunteerReportImage', 'proofUrl', 'updatedAt']);
    }

    // ── مجموعة: users ────────────────────────────────────────
    match /users/{userId} {

      // القراءة: الإدارة أو صاحب الحساب نفسه
      allow read: if isAdmin() || isOwner(userId);

      // إنشاء: فقط للمستخدم نفسه (تسجيل أول مرة)
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'status'])
        && request.resource.data.role in ['donor', 'beneficiary', 'volunteer']
        && ((request.resource.data.role == 'donor' && request.resource.data.status == 'active')
          || (request.resource.data.role in ['beneficiary', 'volunteer']
            && request.resource.data.status == 'pending_verification'));

      // تعديل: الإدارة (أي حقل) أو المستخدم نفسه (اسم + هاتف + صورة فقط)
      allow update: if isAdmin()
        || (isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone', 'photoURL', 'updatedAt']));

      // حذف: السوبر أدمن فقط
      allow delete: if isSuperAdmin();
    }

    // ── مجموعة: cases ─────────────────────────────────────────
    match /cases/{caseId} {

      // القراءة العامة للحالات المنشورة، والإدارة وأصحاب الطلبات والمتطوع لطلباته المسندة.
      allow read: if isAdmin()
        || resource.data.status in ['approved', 'active']
        || (isVolunteer() && (
          resource.data.get('volunteerId', '') == request.auth.uid
          || resource.data.get('assignedVolunteerId', '') == request.auth.uid
        ))
        || (isLoggedIn() && (
          resource.data.beneficiaryId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        ));

      // إنشاء حالة: المستفيد المسجّل أو الإدارة
      allow create: if isAdmin()
        || (isBeneficiary()
          && request.resource.data.beneficiaryId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending');

      // الإدارة تدير الحالات، والمتطوع يكمل المهمة المسندة إليه فقط.
      allow update: if isAdmin()
        || isAssignedVolunteerCompletingCase();

      // حذف: السوبر أدمن فقط
      allow delete: if isSuperAdmin();
    }

    // ── مجموعة: donations ─────────────────────────────────────
    match /donations/{donationId} {

      // القراءة: الإدارة أو المتبرع نفسه
      allow read: if isAdmin()
        || (isLoggedIn() && (
              resource.data.userId == request.auth.uid ||
              resource.data.donorId == request.auth.uid
           ));

      // إنشاء تبرع: أي مستخدم مسجّل
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['caseTitle', 'amountOrItem', 'status'])
        && request.resource.data.status in ['قيد الجمع', 'قيد المراجعة'];

      // تعديل الحالة: الإدارة فقط
      allow update: if isAdmin();

      // حذف: السوبر أدمن فقط
      allow delete: if isSuperAdmin();
    }

    // ── مجموعة: shares ───────────────────────────────────────
    // المستخدم يسجل مشاركاته، والإدارة تعرض السجلات وتدير حذفها.
    match /shares/{shareId} {
      allow read: if isAdmin()
        || (isLoggedIn() && resource.data.userId == request.auth.uid);

      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['caseId', 'caseTitle', 'platform', 'timestamp']);

      allow delete: if isAdmin();
    }

    // ── مجموعة: activity_logs ────────────────────────────────
    // سجل العمليات الإداري: القراءة والإنشاء والحذف متاحة للإدارة فقط.
    match /activity_logs/{logId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'action', 'details', 'adminName', 'adminUid', 'timestamp'
        ]);
    }

    // ── مجموعة: identity_verifications ───────────────────────
    match /identity_verifications/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['beneficiary', 'volunteer']
        && myData().role == request.resource.data.role
        && myData().status == 'pending_verification'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'docType', 'docNumber',
          'docFrontURL', 'verificationStatus', 'submittedAt'
        ]);

      allow update, delete: if isAdmin();
    }

    // ── مجموعة: notifications ──────────────────────────────────
    match /notifications/{notifId} {

      // القراءة: صاحب الإشعار أو الإدارة
      allow read: if isAdmin()
        || (isLoggedIn() && resource.data.userId == request.auth.uid);

      // إنشاء: الإدارة فقط (الكود في donations.js يُنشئ الإشعار)
      allow create: if isAdmin();

      // تعديل isRead: صاحب الإشعار أو الإدارة
      allow update: if isAdmin()
        || (isLoggedIn() &&
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));

      // حذف: صاحب الإشعار أو الإدارة
      allow delete: if isAdmin()
        || (isLoggedIn() && resource.data.userId == request.auth.uid);
    }

    // ── مجموعة: settings ─────────────────────────────────────
    // الإعدادات العامة للروابط والتواصل: قراءة للمستخدمين، وتعديل للإدارة فقط.
    match /settings/{settingId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── مجموعة: volunteerLocations ───────────────────────────
    // الإدارة تراقب المواقع، والمتطوع يكتب موقعه الحالي فقط.
    match /volunteerLocations/{volunteerId} {
      allow read: if isAdmin();
      allow create, update: if isLoggedIn()
        && request.auth.uid == volunteerId
        && myData().role == 'volunteer'
        && myData().status != 'suspended';
      allow delete: if isAdmin() || (isLoggedIn() && request.auth.uid == volunteerId);
    }

    // ── مجموعة: chats ────────────────────────────────────────
    // الإدارة ترى جميع المحادثات، وكل مستخدم يرى محادثته فقط.
    match /chats/{chatId} {
      allow read: if isAdmin()
        || (isLoggedIn() && resource.data.userId == request.auth.uid);

      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'userName', 'createdAt']);

      allow update: if isAdmin()
        || (isLoggedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageTime', 'unreadCount']));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isChatOwner() {
          return isLoggedIn()
            && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        }

        allow read: if isAdmin() || isChatOwner();

        allow create: if isAdmin()
          || (isChatOwner()
            && request.resource.data.sender == 'user'
            && request.resource.data.senderId == request.auth.uid)
          || (isChatOwner()
            && request.resource.data.sender == 'admin'
            && request.resource.data.senderId == 'support'
            && request.resource.data.text == 'مرحباً بك في تكافل! كيف يمكننا مساعدتك؟');

        allow update: if isAdmin()
          || (isChatOwner()
            && resource.data.sender == 'user'
            && resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'updatedAt']));

        allow delete: if isAdmin()
          || (isChatOwner()
            && resource.data.sender == 'user'
            && resource.data.senderId == request.auth.uid);
      }
    }

    // ── منع أي وصول لمجموعات غير محددة ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
